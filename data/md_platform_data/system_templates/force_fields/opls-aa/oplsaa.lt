# OPLS-AA力场主力场文件
# Optimized Potentials for Liquid Simulations - All Atom
#
# 功能说明：
#   OPLS-AA力场的入口文件，定义力场的基本设置和全局参数。
#   该文件导入ffbonded.lt和ffnonbonded.lt，提供完整的力场定义。
#
# 使用方法：
#   在分子模板文件中使用以下命令导入此力场：
#   import "oplsaa.lt"
#
# 参考文献：
#   Jorgensen, W. L., et al. J. Am. Chem. Soc. 1996, 118, 11225-11236
#   Price, M. L. P., et al. J. Comput. Chem. 2001, 22, 1340-1352
#
# 作者: Electrolyte MD Platform
# 版本: 1.0

# ========================================
# 力场基本信息
# ========================================

# 力场名称：OPLS-AA (Optimized Potentials for Liquid Simulations - All Atom)
# 力场类型：全原子力场
# 适用范围：
#   - 有机小分子（烷烃、烯烃、芳香化合物、醇、醚、酮、酯、胺等）
#   - 生物分子（氨基酸、蛋白质、核酸）
#   - 电解液相关分子（碳酸酯溶剂、锂盐）
#   - 离子液体

# ========================================
# 导入子模块
# ========================================

# 导入非键相互作用参数（LJ参数、原子类型定义）
import "ffnonbonded.lt"

# 导入键相互作用参数（键、角度、二面角、非正常二面角）
import "ffbonded.lt"

# ========================================
# 力场全局设置
# ========================================

# 定义力场名称标识
OPLSAA {

  # ========================================
  # 能量单位设置
  # ========================================
  # OPLS-AA使用以下单位系统：
  # - 能量：kcal/mol
  # - 距离：Angstrom
  # - 时间：fs (femtoseconds)
  # - 质量：amu (atomic mass units)
  # - 温度：K (Kelvin)
  # - 压力：bar
  
  # 在LAMMPS中对应设置：
  # units real

  # ========================================
  # 非键相互作用设置
  # ========================================
  
  # LJ势函数类型：12-6 LJ势
  # E(r) = 4 * epsilon * [(sigma/r)^12 - (sigma/r)^6]
  
  # 在LAMMPS中对应设置：
  # pair_style lj/cut/coul/long 12.0 12.0
  # pair_modify mix geometric
  
  # 截断半径设置
  # LJ截断：12.0 Angstrom
  # 静电截断：12.0 Angstrom（使用Ewald或PME处理长程部分）
  
  # 在LAMMPS中对应设置：
  # kspace_style pppm 1.0e-5

  # ========================================
  # 1-4相互作用缩放因子
  # ========================================
  # OPLS-AA标准缩放因子：
  # - 1-2相互作用：完全排除（权重=0）
  # - 1-3相互作用：完全排除（权重=0）
  # - 1-4相互作用：部分缩放（权重=0.5）
  
  # 在LAMMPS中对应设置：
  # special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.5

  # ========================================
  # 键相互作用设置
  # ========================================
  
  # 键伸缩势：谐振子势
  # E(r) = K * (r - r0)^2
  
  # 在LAMMPS中对应设置：
  # bond_style harmonic

  # ========================================
  # 角度相互作用设置
  # ========================================
  
  # 键角弯曲势：谐振子势
  # E(theta) = K * (theta - theta0)^2
  
  # 在LAMMPS中对应设置：
  # angle_style harmonic

  # ========================================
  # 二面角相互作用设置
  # ========================================
  
  # 二面角扭转势：OPLS型傅里叶展开
  # E(phi) = V1*(1+cos(phi)) + V2*(1-cos(2phi)) + V3*(1+cos(3phi)) + V4*(1+cos(4phi))
  # 或等价形式：
  # E(phi) = sum(Vn * (1 + cos(n*phi - gamma)))
  
  # 在LAMMPS中对应设置：
  # dihedral_style opls

  # ========================================
  # 非正常二面角设置
  # ========================================
  
  # 非正常二面角势：谐振子势
  # 用于维持平面构型（sp2碳、芳香环）或手性中心
  # E(phi) = K * (phi - phi0)^2
  
  # 在LAMMPS中对应设置：
  # improper_style harmonic

  # ========================================
  # Lennard-Jones参数定义 (电解液相关原子类型)
  # ========================================
  # 格式：pair_coeff TYPE1 TYPE2 epsilon sigma
  # epsilon单位：kcal/mol
  # sigma单位：Angstrom
  # 使用几何平均组合规则计算混合参数
  # ========================================
  
  write_once("In Settings") {
    # 磷原子LJ参数 (PF6中的P)
    # epsilon = 0.200 kcal/mol, sigma = 3.70 Angstrom
    # 来源: J. Phys. Chem. B 2006
    pair_coeff @atom:opls_901 @atom:opls_901 0.200 3.70
    
    # 氟原子LJ参数 (PF6中的F)
    # epsilon = 0.255 kcal/mol, sigma = 2.95 Angstrom
    # 来源: J. Phys. Chem. B 2006
    pair_coeff @atom:opls_303 @atom:opls_303 0.255 2.95
    
    # 锂离子LJ参数 (Joung-Cheatham参数)
    # epsilon = 0.00034 kcal/mol, sigma = 2.126 Angstrom
    # 来源: J. Phys. Chem. B 2006 (Joung-Cheatham)
    pair_coeff @atom:opls_402 @atom:opls_402 0.00034 2.126
  }

  # ========================================
  # 键参数定义 (电解液相关键类型)
  # ========================================
  # 格式：bond_coeff TYPE K r0
  # K单位：kcal/mol/Angstrom^2
  # r0单位：Angstrom
  # ========================================
  
  write_once("In Settings") {
    # P-F键参数 (六氟磷酸盐)
    # K = 420.0 kcal/mol/A^2, r0 = 1.560 Angstrom
    # 来源: J. Phys. Chem. B 2006
    bond_coeff @bond:P-F harmonic 420.0 1.560
  }

  # ========================================
  # 角度参数定义 (电解液相关角度类型)
  # ========================================
  # 格式：angle_coeff TYPE K theta0
  # K单位：kcal/mol/rad^2
  # theta0单位：degree
  # ========================================
  
  write_once("In Settings") {
    # F-P-F角度参数 (六氟磷酸盐，八面体几何)
    # K = 80.0 kcal/mol/rad^2, theta0 = 90.0 degree
    # 来源: J. Phys. Chem. B 2006
    angle_coeff @angle:F-P-F harmonic 80.0 90.0
  }

}

# ========================================
# 原子类型分类说明
# ========================================
# OPLS-AA原子类型编号规则：
#
# 1xx系列：碳原子类型
#   - 135-138：sp3碳（烷烃）
#   - 141-142：sp2碳（烯烃）
#   - 145-146：芳香碳
#   - 209-212：羰基/羧基碳
#
# 2xx系列：氢原子类型
#   - 139-140：烷烃氢
#   - 143：烯烃氢
#   - 148：芳香氢
#   - 154：羟基氢
#   - 160：胺基氢
#
# 3xx系列：氧原子类型
#   - 154：羟基氧（与羟基氢共用编号）
#   - 156：醚氧
#   - 211：羰基氧
#   - 213：羧基氧
#
# 4xx系列：氮原子类型
#   - 157-159：胺氮
#   - 236：酰胺氮
#
# 5xx系列：卤素原子类型
#   - 303：氟
#   - 307：氯
#   - 311：溴
#
# 9xx系列：特殊原子类型（电解液相关）
#   - 901：PF6磷原子
#   - 903：磺酰基硫原子
#   - 402：锂离子

# ========================================
# 电解液常用分子参数参考
# ========================================
# 碳酸酯溶剂（EC, DMC, EMC, DEC）：
#   - 碳原子：opls_135 (CH3), opls_136 (CH2), opls_209 (羰基C)
#   - 氧原子：opls_156 (醚氧), opls_211 (羰基O)
#   - 氢原子：opls_140 (CH3-H), opls_139 (CH2-H)
#
# LiPF6电解质盐：
#   - 锂离子：opls_402 (Li+)
#   - 磷原子：opls_901 (P)
#   - 氟原子：opls_303 (F)
#
# LiTFSI电解质盐：
#   - 锂离子：opls_402 (Li+)
#   - 硫原子：opls_903 (磺酰基S)
#   - 氟原子：opls_303 (F)

# ========================================
# 使用示例
# ========================================
# 创建分子模板时，继承此力场并指定原子类型：
#
# EC.lt（碳酸乙烯酯）示例：
# ```
# import "oplsaa.lt"
#
# EC {
#   # 继承OPLS-AA力场
#   inherit OPLSAA
#
#   # 定义原子
#   write_once("Data Atoms") {
#     $atom:C1  $atom:opls_209  0.000  C  0.0 0.0 0.0
#     $atom:O1  $atom:opls_211  0.000  O  1.2 0.0 0.0
#     $atom:O2  $atom:opls_156  0.000  O  -1.2 0.0 0.0
#     ...
#   }
#
#   # 定义键
#   write_once("Data Bonds") {
#     $bond:C1-O1  $bond:C=O  $atom:C1  $atom:O1
#     $bond:C1-O2  $bond:C-O   $atom:C1  $atom:O2
#     ...
#   }
# }
# ```

# ========================================
# 参数来源说明
# ========================================
# OPLS-AA力场参数主要来源于：
# 1. 实验数据拟合（密度、蒸发焓、自由能等）
# 2. 高水平量子化学计算（MP2、CCSD(T)等）
# 3. 经验规则推导（相似分子类比）
#
# 参数验证方法：
# - 液体密度计算与实验对比
# - 蒸发焓计算与实验对比
# - 自由能计算与实验对比
# - 构象能量与量子化学计算对比

# ========================================
# 注意事项
# ========================================
# 1. 部分电荷分配：
#    OPLS-AA的部分电荷通常根据分子类型和经验规则分配，
#    常用方法包括：
#    - 基于官能团的电荷增量法
#    - 基于量子化学计算的RESP拟合
#    - 基于已有分子的类比
#
# 2. 1-4相互作用：
#    OPLS-AA对1-4相互作用使用0.5的缩放因子，
#    这与某些力场（如AMBER）不同，需要特别注意。
#
# 3. 组合规则：
#    OPLS-AA使用几何平均组合规则计算不同原子类型间的LJ参数：
#    epsilon_ij = sqrt(epsilon_i * epsilon_j)
#    sigma_ij = sqrt(sigma_i * sigma_j)
#
# 4. 长程静电：
#    建议使用PPPM或Ewald方法处理长程静电相互作用，
#    截断半径通常设为10-12 Angstrom。

# ========================================
# 文件结束
# ========================================