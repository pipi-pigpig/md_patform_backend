# =============================================================================
# Li.lt - 锂离子分子模板 (Lithium Ion)
# =============================================================================
# 功能: 定义Li+离子的拓扑结构和力场参数
# 力场: Joung-Cheatham离子参数 (独立参数，不继承OPLS-AA)
#
# 分子结构:
#   - 单原子离子
#   - 总电荷: +1.0
#
# 力场参数 (Joung-Cheatham):
#   - epsilon: 0.00034 kcal/mol
#   - sigma: 2.126 Angstrom
#   - 参考文献: Joung & Cheatham, J. Phys. Chem. B 2008, 112, 9020-9041
#
# 作者: Electrolyte MD Platform
# 版本: 2.0
# =============================================================================

# Li离子定义 - 使用独立的Joung-Cheatham参数
# 注意: Li离子不继承OPLSAA力场，因为使用的是专门的离子参数
Li {
  # ========================================
  # 原子质量定义
  # ========================================
  
  write_once("Data Masses") {
    @atom:Li  6.941
  }
  
  # ========================================
  # 原子定义 (Data Atoms)
  # ========================================
  # 单原子离子，电荷+1.0
  
  write('Data Atoms') {
    $atom:Li1  $mol:.   @atom:Li  1.0  0.000  0.000  0.000
  }
  
  # ========================================
  # LJ参数定义 (In Settings)
  # ========================================
  # Joung-Cheatham参数:
  # epsilon = 0.00034 kcal/mol
  # sigma = 2.126 Angstrom (直径，LAMMPS使用sigma作为直径)
  # 注意: LAMMPS的pair_coeff格式是 epsilon sigma
  
  write_once("In Settings") {
    pair_coeff @atom:Li @atom:Li 0.00034 2.126
  }
}