# =============================================================================
# LAMMPS Production Simulation Input Script
# Generated by Jinja2 template engine
# Generation time: {{ generation_time }}
# Job ID: {{ job_id }}
# Target properties: {{ target_properties | join(', ') }}
# =============================================================================

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles (using cutoff Coulomb to handle non-neutral system charge)
# Note: PPPM requires charge neutrality. The current force field gives DMC
# molecules a net charge of +0.12 each, making the system non-neutral.
# Using lj/cut/coul/cut with no kspace as a workaround.
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
pair_style      lj/cut/coul/cut {{ cutoff | default(8.0) }} {{ cutoff | default(8.0) }}
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read equilibrated configuration
read_data       equilibrated.data

# Force field parameters (PPPM auto-selects grid size)
include         system.in.settings

# Neighbor list settings (delay 5 to reduce overhead)
neighbor        2.0 bin
neigh_modify    every 1 delay 5 check yes

# Thermodynamic output
thermo          {{ thermo_freq | default(100) }}
{% if 'density' in target_properties %}
thermo_style    custom step temp pe ke etotal press vol density
{% else %}
thermo_style    custom step temp pe ke etotal press vol
{% endif %}

# Output thermodynamic data to thermo.out file (for post-processing analysis)
# Format: step temp pe ke etotal press vol density
variable        s_out equal step
variable        t_out equal temp
variable        pe_out equal pe
variable        ke_out equal ke
variable        et_out equal etotal
variable        pr_out equal press
variable        v_out equal vol
variable        d_out equal density
fix             thermo_out all print {{ thermo_freq | default(100) }} "${s_out} ${t_out} ${pe_out} ${ke_out} ${et_out} ${pr_out} ${v_out} ${d_out}" file thermo.out screen no

# Trajectory output (production)
dump            1 all custom {{ dump_freq | default(1000) }} dump.trajectory.lammpstrj id mol type x y z vx vy vz

{% if 'conductivity' in target_properties or 'dielectric' in target_properties %}
# Conductivity/Dielectric: output trajectory with charges AND velocities
# Green-Kubo电导率计算需要同时包含电荷(q)和速度(vx,vy,vz)
# 因为 J = Σ(qi*vi)，缺少速度会导致电流密度为0
compute         charge all property/atom q
dump            2 all custom {{ dump_freq | default(1000) }} dump.charge.lammpstrj id type x y z vx vy vz c_charge
{% endif %}

{% if 'viscosity' in target_properties %}
# Viscosity: output pressure tensor
compute         pTensor all pressure thermo_temp
fix             pressure all ave/time {{ ave_freq | default(100) }} 1 {{ ave_freq | default(100) }} c_pTensor[*] file pressure.dat mode vector
{% endif %}

{% if 'dielectric' in target_properties %}
# Dielectric: output per-atom dipole moment
compute         dipole all dipole/atom
fix             dipole all ave/time {{ ave_freq | default(100) }} 1 {{ ave_freq | default(100) }} c_dipole[*] file dipole.dat
# Dielectric: output total system dipole moment (sum of per-atom dipoles)
compute         totDipole all reduce sum c_dipole[1] c_dipole[2] c_dipole[3]
fix             totDipole all ave/time {{ ave_freq | default(100) }} 1 {{ ave_freq | default(100) }} c_totDipole[*] file total_dipole.dat
{% endif %}

{% if 'solvation_structure' in target_properties %}
# Solvation structure: output reduced trajectory for RDF analysis
dump            3 all custom {{ dump_freq | default(1000) }} dump.solvation.lammpstrj id mol type x y z
{% endif %}

# NPT production simulation
timestep        {{ timestep | default(1.0) }}
fix             1 all npt temp {{ temp | default(300.0) }} {{ temp | default(300.0) }} {{ tau_t | default(100.0) }} iso {{ press | default(1.0) }} {{ press | default(1.0) }} {{ tau_p | default(1000.0) }}
run             {{ nsteps | default(100000) }}
unfix           1

# Output final configuration
write_data      final.data