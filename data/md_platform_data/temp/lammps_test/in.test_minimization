# LAMMPS能量最小化测试脚本
# 用于验证OPLS-AA力场参数
#
# 功能说明：
#   1. 读取EC分子测试数据
#   2. 设置OPLS-AA力场参数
#   3. 执行能量最小化
#   4. 输出能量和验证结果
#
# 作者: Electrolyte MD Platform
# 版本: 1.0

# ========================================
# 初始化设置
# ========================================
units           real
atom_style      full
boundary        f f f

# ========================================
# 读取数据文件
# ========================================
read_data       test_ec.data

# ========================================
# 力场设置 - OPLS-AA
# ========================================

# 非键相互作用
# LJ势函数类型：12-6 LJ势，带长程静电
pair_style      lj/cut/coul/long 12.0 12.0
pair_modify     mix geometric

# 键相互作用
bond_style      harmonic

# 角度相互作用
angle_style     harmonic

# 二面角相互作用 - OPLS型
dihedral_style  opls

# 非正常二面角
improper_style  harmonic

# 长程静电处理
kspace_style    pppm 1.0e-5

# 1-4相互作用缩放因子
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5

# ========================================
# LJ参数 (OPLS-AA)
# ========================================
# 格式: pair_coeff type1 type2 epsilon(kcal/mol) sigma(Angstrom)

# 碳原子 (羰基碳 opls_209)
pair_coeff 1 1 0.066 3.75

# 氧原子 (羰基氧 opls_211)
pair_coeff 2 2 0.210 2.96

# CH2基团 (opls_136)
pair_coeff 3 3 0.056 3.98

# 氧原子 (醚氧 opls_156)
pair_coeff 4 4 0.170 3.00

# 氢原子 (opls_140)
pair_coeff 5 5 0.030 2.50

# 交叉项 (几何平均)
pair_coeff 1 2 0.1177 3.335
pair_coeff 1 3 0.0608 3.865
pair_coeff 1 4 0.1058 3.375
pair_coeff 1 5 0.0445 3.125
pair_coeff 2 3 0.1083 3.470
pair_coeff 2 4 0.1890 2.980
pair_coeff 2 5 0.0794 2.730
pair_coeff 3 4 0.0975 3.490
pair_coeff 3 5 0.0410 3.240
pair_coeff 4 5 0.0714 2.750

# ========================================
# 键参数 (谐振子势)
# ========================================
# 格式: bond_coeff type K(kcal/mol/A^2) r0(Angstrom)

bond_coeff 1  650.0  1.229   # C=O (double bond)
bond_coeff 2  310.0  1.522   # C-C (single bond)
bond_coeff 3  310.0  1.522   # C-C (single bond)
bond_coeff 4  340.0  1.410   # C-O (ether)
bond_coeff 5  340.0  1.090   # C-H

# ========================================
# 角度参数 (谐振子势)
# ========================================
# 格式: angle_coeff type K(kcal/mol/rad^2) theta0(degree)

angle_coeff 1  70.0  120.0   # O=C-C (carbonyl)
angle_coeff 2  63.0  112.0   # C-C-C
angle_coeff 3  70.0  110.0   # C-C-O
angle_coeff 4  60.0  105.0   # C-O-C (ether)
angle_coeff 5  35.0  109.5   # C-C-H

# ========================================
# 二面角参数 (OPLS型)
# ========================================
# 格式: dihedral_coeff type V1 V2 V3 V4 (kcal/mol)

dihedral_coeff 1  0.0  0.0  0.0  0.0   # O=C-C-O (carbonyl)
dihedral_coeff 2  0.0  0.0  0.0  0.0   # C-C-C-O
dihedral_coeff 3  0.0  0.0  0.0  0.0   # C-C-O-C (ring)
dihedral_coeff 4  0.0  0.0  0.0  0.0   # O=C-C-H
dihedral_coeff 5  0.0  0.0  0.0  0.0   # C-C-C-H

# ========================================
# 非正常二面角参数
# ========================================
# 格式: improper_coeff type K(kcal/mol/rad^2) phi0(degree)

improper_coeff 1  40.0  180.0   # Carbonyl planar

# ========================================
# 邻居列表设置
# ========================================
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ========================================
# 输出设置
# ========================================
thermo          10
thermo_style    custom step temp pe ke etotal press vol density

# ========================================
# 能量最小化
# ========================================
print "========================================"
print "开始能量最小化测试"
print "========================================"

# 计算初始能量
run 0

print "========================================"
print "初始能量计算完成"
print "开始最小化..."
print "========================================"

# 能量最小化
min_style       cg
minimize        1.0e-4 1.0e-6 100 1000

print "========================================"
print "能量最小化完成"
print "========================================"

# 最终能量
run 0

# ========================================
# 输出最终结构
# ========================================
write_data      minimized.data

print "========================================"
print "测试完成!"
print "最小化后的结构已保存到 minimized.data"
print "========================================"