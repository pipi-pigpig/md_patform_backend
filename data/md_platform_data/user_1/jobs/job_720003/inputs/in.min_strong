# =============================================================================
# Strong soft potential minimization
# Use very high prefactor to push atoms apart aggressively
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

read_data       system.data

# Very strong soft potential
pair_style      soft 1.0
pair_coeff      * * 100.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
special_bonds   lj 1.0 1.0 1.0 coul 1.0 1.0 1.0
kspace_style    none

include         system.in.bond_angle_only

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000
thermo          1000
thermo_style    custom step temp pe ke etotal press vol

min_style       fire
minimize        1.0e-4 1.0e-6 1000 10000

write_data      minimized_strong.data
