units           real
atom_style      full

read_data       system.data

pair_style      lj/cut/coul/cut 12.0 12.0
pair_coeff      * * 0.0 0.0
bond_style      harmonic
bond_coeff      * 0.0 0.0
angle_style     harmonic
angle_coeff     * 0.0 0.0
dihedral_style  none
improper_style  none
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
thermo          1

min_style       sd
minimize 0.0 1.0e-6 10 100

write_data      test_minimal.data
