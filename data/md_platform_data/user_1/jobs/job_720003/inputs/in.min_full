# =============================================================================
# Two-step minimization
# Step 1: Soft potential (resolves overlaps)
# Step 2: Quick real force field refinement
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

read_data       system.data

# Step 1: Soft potential to resolve overlaps
pair_style      soft 1.0
pair_coeff      * * 1.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
special_bonds   lj 1.0 1.0 1.0 coul 1.0 1.0 1.0
kspace_style    none

include         system.in.bond_angle_only

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000
thermo          1000
thermo_style    custom step temp pe ke etotal press vol

min_style       fire
minimize        1.0e-4 1.0e-6 1000 10000

write_data      minimized_soft.data

# Step 2: Quick real force field refinement (short cutoff, few steps)
reset_timestep  0
pair_style      lj/cut/coul/cut 8.0 8.0
kspace_style    none
pair_modify     mix geometric
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
improper_style  none
dihedral_style  opls

include         system.in.settings.no_imp

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

min_style       fire
minimize        1.0e-2 1.0e-4 100 1000

write_data      minimized.data
