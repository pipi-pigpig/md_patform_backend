LAMMPS (23 Jun 2022 - Update 4)
# =============================================================================
# Fresh approach: start from original system.data, use soft potential
# Then switch to real force field with proper pair coeffs
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Read original data file
read_data       system.data
