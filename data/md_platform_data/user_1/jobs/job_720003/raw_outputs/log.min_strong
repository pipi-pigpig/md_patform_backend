# Very strong soft potential
pair_style      soft 1.0
pair_coeff      * * 100.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
special_bonds   lj 1.0 1.0 1.0 coul 1.0 1.0 1.0
