#
# Five-phase gradual relaxation strategy:
#   Phase 0: Real LJ CG minimization (cutoff=6.0A) to relax any residual stress
#            from the minimization stage. The minimization stage's Step 3 already
#            uses real LJ with cutoff=6.0A, so this is a continuation.
#   Phase 1: NVE/limit with cutoff=6.0A for dynamic relaxation.
#   Phase 2: NVE/limit with medium cutoff=7.0A.
#   Phase 3: NVE/limit with full cutoff=8.0A.
#   Phase 4: NVT thermostat at target temperature.
#   Phase 5: NPT barostat at target pressure.
#
# CRITICAL FIX (v3):
#   Previous versions had Phase 0a using soft potential A=10000 with cutoff=8.0A.
#   This created forces up to 2*10000/8.0 = 2500, which is 4-9x stronger than
#   bond forces (k=268-570). This destroyed the molecular structure that the
#   minimization stage carefully preserved.
#   Now we SKIP the soft potential phase entirely because the minimization
#   stage's Step 3 already transitions to real LJ with cutoff=6.0A. We start
#   equilibrium with the same real LJ cutoff=6.0A and gradually increase it.

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Start with real LJ at cutoff=6.0A (matches minimization Step 3)
pair_style      lj/cut/coul/cut 6.0 6.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read the FINAL minimized configuration (from minimization step 3)
read_data       minimized.data
