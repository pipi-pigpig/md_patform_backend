# =============================================================================
# LAMMPS Minimization Input Script (Gentle Soft Potential Strategy)
# Generated by Jinja2 template engine
# Generation time: 2026-06-29T21:27:44.294282
# Job ID: 1230001
# =============================================================================
#
# Gentle three-step minimization strategy:
#   Step 1: Soft potential (A=100, cutoff=3.0A) to resolve the worst
#           inter-molecular overlaps without destroying bonded structure.
#   Step 2: Soft potential (A=100, cutoff=5.0A) to further relax
#           moderate-distance contacts.
#   Step 3: Real LJ potential (cutoff=6.0A) for final relaxation under
#           the actual force field with a reduced cutoff.
#
# CRITICAL FIX (v3):
#   Previous versions used A=10000 which created forces up to 20000,
#   completely overwhelming bonded interactions (bond k=268-570).
#   This caused bonds to be stretched to 12+ Å or compressed to 0.003 Å,
#   destroying the molecular structure.
#   Now using A=100 (max force ~67) which is weaker than bond forces,
#   allowing gentle separation of overlaps while preserving bonds.
#
# Bond force constants for reference:
#   C-C (sp3): k=268, C=C: k=414, C=O: k=570, C-H: k=340, C-O: k=320
#   With A=100 and cutoff=3.0: max soft force = 2*100/3.0 = 67
#   This is 4-8x weaker than the weakest bond force, ensuring bonds
#   are not overwhelmed.

# =============================================================================
# Step 1: Soft potential with small cutoff (3.0A) - resolve worst overlaps
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions (needed for bond/angle force computation)
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Use lj/cut first to match the pair_coeff format in system.in.settings
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data

# Include force field parameters (bond_coeff, angle_coeff)
include         system.in.settings

# Switch to soft potential with small cutoff (3.0A)
# A=100: gentle repulsive force (max 2*A/rc = 67 at r=0)
# This is weaker than bond forces (k=268-570), preserving molecular structure
pair_style      soft 3.0
pair_coeff      * * 100.0

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# SD minimization (Steepest Descent - robust for high-energy starts)
min_style       sd
minimize        0.0001 0.0001 500 500

# Write step 1 result
write_data      minimized_s1.data nocoeff

# =============================================================================
# Step 2: Soft potential with medium cutoff (5.0A) - relax moderate contacts
# =============================================================================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

read_data       minimized_s1.data
include         system.in.settings

# Soft potential with cutoff=5.0A, A=100
pair_style      soft 5.0
pair_coeff      * * 100.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press vol

min_style       sd
minimize        0.0001 0.0001 500 500

# Write step 2 result
write_data      minimized_s2.data nocoeff

# =============================================================================
# Step 3: Real LJ potential with reduced cutoff (6.0A) - final relaxation
# This transitions from soft potential to the actual force field gradually.
# Using a reduced cutoff (6.0A instead of 8.0A) limits the number of
# interacting pairs and prevents energy explosions from residual close contacts.
# =============================================================================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Real LJ potential with reduced cutoff
pair_style      lj/cut/coul/cut 6.0 6.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

read_data       minimized_s2.data
include         system.in.settings

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press vol

min_style       sd
minimize        0.0001 0.0001 500 500

# Write final minimized configuration
write_data      minimized.data nocoeff
