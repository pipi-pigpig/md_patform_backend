# =============================================================================
# LAMMPS Equilibrium Input Script (Gradual LJ Cutoff Relaxation)
# Generated by Jinja2 template engine
# Generation time: 2026-06-29T21:27:44.294282
# Job ID: 1230001
# =============================================================================
#
# Five-phase gradual relaxation strategy:
#   Phase 0: Real LJ CG minimization (cutoff=6.0A) to relax any residual stress
#            from the minimization stage. The minimization stage's Step 3 already
#            uses real LJ with cutoff=6.0A, so this is a continuation.
#   Phase 1: NVE/limit with cutoff=6.0A for dynamic relaxation.
#   Phase 2: NVE/limit with medium cutoff=7.0A.
#   Phase 3: NVE/limit with full cutoff=8.0A.
#   Phase 4: NVT thermostat at target temperature.
#   Phase 5: NPT barostat at target pressure.
#
# CRITICAL FIX (v3):
#   Previous versions had Phase 0a using soft potential A=10000 with cutoff=8.0A.
#   This created forces up to 2*10000/8.0 = 2500, which is 4-9x stronger than
#   bond forces (k=268-570). This destroyed the molecular structure that the
#   minimization stage carefully preserved.
#   Now we SKIP the soft potential phase entirely because the minimization
#   stage's Step 3 already transitions to real LJ with cutoff=6.0A. We start
#   equilibrium with the same real LJ cutoff=6.0A and gradually increase it.

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Start with real LJ at cutoff=6.0A (matches minimization Step 3)
pair_style      lj/cut/coul/cut 6.0 6.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read the FINAL minimized configuration (from minimization step 3)
read_data       minimized.data

# Include force field parameters (bond_coeff, angle_coeff, pair_coeff)
include         system.in.settings

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol density

# =============================================================================
# Phase 0: Real LJ CG minimization (cutoff=6.0A)
# Use CG minimization with the actual force field to relax any residual stress
# from the minimization stage. Cutoff=6.0A matches minimization Step 3, ensuring
# a smooth transition. CG is safe here because the structure is already relaxed.
# =============================================================================
min_style       cg
minimize        1.0e-6 1.0e-6 1000 1000

# =============================================================================
# Phase 1: NVE/limit with cutoff=6.0A
# Small timestep (0.1 fs) and strict displacement limit (0.05 A) for safety.
# NVE/limit is robust against residual close contacts.
# =============================================================================
timestep        0.1
fix             nve_limit all nve/limit 0.05
run             500
unfix           nve_limit

# =============================================================================
# Phase 2: NVE/limit with medium cutoff=7.0A
# =============================================================================
pair_style      lj/cut/coul/cut 7.0 7.0
include         system.in.settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
fix             nve_limit all nve/limit 0.1
run             500
unfix           nve_limit

# =============================================================================
# Phase 3: NVE/limit with full cutoff=8.0A
# =============================================================================
pair_style      lj/cut/coul/cut 8.0 8.0
include         system.in.settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
fix             nve_limit all nve/limit 0.2
run             500
unfix           nve_limit

# =============================================================================
# Phase 4: NVT equilibration
# =============================================================================
velocity        all create 353.0 93856 dist gaussian
fix             nvt all nvt temp 353.0 353.0 100.0
timestep        1.0

# Trajectory output
dump            1 all custom 50 dump.equilibrium.lammpstrj id mol type x y z vx vy vz

run             500
unfix           nvt

# =============================================================================
# Phase 5: NPT equilibration
# =============================================================================
fix             npt all npt temp 353.0 353.0 100.0 iso 1.0 1.0 1000.0
timestep        1.0
run             500
unfix           npt

# Output equilibrated configuration
write_data      equilibrated.data
