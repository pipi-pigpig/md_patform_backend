# =============================================================================
# LAMMPS Minimization Input Script (Three-Step Soft Potential Strategy)
# Generated by Jinja2 template engine
# Generation time: 2026-06-29T21:14:55.104091900
# Job ID: 1200001
# =============================================================================
#
# Three-step minimization strategy (using SD for robustness):
#   Step 1: Soft potential (SD, cutoff=2.5A, A=10000) to resolve the worst
#           atom overlaps from Packmol packing.
#   Step 2: Soft potential (SD, cutoff=4.0A, A=10000) to further relax
#           atoms within a larger radius.
#   Step 3: Soft potential (SD, cutoff=6.0A, A=10000) to push apart atoms
#           at moderate distances before real LJ potential.
#
# Key changes from previous version:
#   - Use SD (Steepest Descent) instead of CG to avoid line search failures
#     that occur when initial forces are extremely large (CG alpha -> 0).
#   - Reduce A from 100000 to 10000 to make forces more manageable.
#   - Increase cutoff from 1.5 to 2.5 in Step 1 to catch more overlaps.
#   - Increase max iterations to allow full convergence.
#
# Note: After soft potential minimization, the equilibration stage uses
# real LJ potential with gradual cutoff increase and NVE/limit to safely
# relax the remaining overlaps.

# =============================================================================
# Step 1: Soft potential with small cutoff (2.5A)
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions (needed for bond/angle force computation)
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Use lj/cut first to match the pair_coeff format in system.in.settings
# (pair_coeff has 2 params: epsilon,sigma; soft style expects 1 param: A)
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data
