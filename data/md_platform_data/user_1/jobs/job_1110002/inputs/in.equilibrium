# =============================================================================
# LAMMPS Equilibrium Input Script (Soft-to-LJ Transition + Gradual Relaxation)
# Generated by Jinja2 template engine
# Generation time: 2026-06-29T16:56:45.145706600
# Job ID: 1110002
# =============================================================================
#
# Six-phase gradual relaxation strategy:
#   Phase 0a: Soft potential CG minimization (cutoff=8.0A, A=100000) to push
#             all overlapping atoms to safe distances. This is an extension of
#             the minimization stage's soft potential strategy, using a larger
#             cutoff to catch all remaining close contacts.
#   Phase 0b: Real LJ CG minimization (cutoff=4.0A) to relax the structure
#             under the actual force field. After Phase 0a, atoms are far
#             enough apart that LJ energy is finite.
#   Phase 1:  NVE/limit with small cutoff (4.0A) for dynamic relaxation.
#   Phase 2:  NVE/limit with medium cutoff (6.0A).
#   Phase 3:  NVE/limit with full cutoff (8.0A).
#   Phase 4:  NVT thermostat at target temperature.
#   Phase 5:  NPT barostat at target pressure.
#
# Key insight: soft potential A*(1-r/rc)^2 is finite at r=0, but LJ 1/r^12
# diverges. The minimization stage's 3-step soft potential may leave some atom
# pairs too close for LJ. Phase 0a with cutoff=8.0A catches ALL close contacts
# within the LJ interaction range, ensuring Phase 0b starts with finite energy.

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Start with lj/cut to match pair_coeff format in system.in.settings
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read the FINAL minimized configuration (from minimization step 3)
read_data       minimized.data

# Include force field parameters (bond_coeff, angle_coeff, pair_coeff)
include         system.in.settings

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol density

# =============================================================================
# Phase 0a: Soft potential SD minimization (cutoff=8.0A)
# Push all overlapping atoms to safe distances before real LJ.
# A=500000 provides strong repulsive force up to 8.0A cutoff.
# Using min_style sd (steepest descent) which is more robust for high-energy
# starting points than cg. Tight tolerances ensure full convergence.
# =============================================================================
pair_style      soft 8.0
pair_coeff      * * 500000.0
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
min_style       sd
minimize        1.0e-12 1.0e-8 2000 2000

# =============================================================================
# Phase 0b: Real LJ SD minimization (cutoff=4.0A)
# After Phase 0a, atoms are at safe distances. Use real LJ with steepest
# descent (sd) for a quick pre-relaxation. SD is faster and more robust
# than CG for high-energy starting points. Only 200 iterations to remove
# worst overlaps; NVE/limit phases will handle the rest.
# =============================================================================
pair_style      lj/cut/coul/cut 4.0 4.0
include         system.in.settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
min_style       sd
minimize        0.0 1.0e-2 200 200

# =============================================================================
# Phase 1: NVE with small cutoff (4.0A) and strict displacement limit
# After CG minimization, atoms are far enough apart for stable dynamics.
# =============================================================================
timestep        0.1
fix             nve_limit all nve/limit 0.05
run             500
unfix           nve_limit

# =============================================================================
# Phase 2: NVE with medium cutoff (6.0A)
# =============================================================================
pair_style      lj/cut/coul/cut 6.0 6.0
include         system.in.settings
fix             nve_limit all nve/limit 0.1
run             500
unfix           nve_limit

# =============================================================================
# Phase 3: NVE with full cutoff (8.0A)
# =============================================================================
pair_style      lj/cut/coul/cut 8.0 8.0
include         system.in.settings
fix             nve_limit all nve/limit 0.2
run             500
unfix           nve_limit

# =============================================================================
# Phase 4: NVT equilibration
# =============================================================================
velocity        all create 353.0 15075 dist gaussian
fix             nvt all nvt temp 353.0 353.0 100.0
timestep        1.0

# Trajectory output
dump            1 all custom 50 dump.equilibrium.lammpstrj id mol type x y z vx vy vz

run             500
unfix           nvt

# =============================================================================
# Phase 5: NPT equilibration
# =============================================================================
fix             npt all npt temp 353.0 353.0 100.0 iso 1.0 1.0 1000.0
timestep        1.0
run             500
unfix           npt

# Output equilibrated configuration
write_data      equilibrated.data
