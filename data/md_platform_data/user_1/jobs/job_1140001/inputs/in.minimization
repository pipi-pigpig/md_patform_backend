# =============================================================================
# LAMMPS Minimization Input Script (Three-Step Soft Potential Strategy)
# Generated by Jinja2 template engine
# Generation time: 2026-06-29T20:50:02.153393800
# Job ID: 1140001
# =============================================================================
#
# Three-step minimization strategy:
#   Step 1: Soft potential (CG, cutoff=1.5A, A=100000) to resolve the worst
#           atom overlaps from Packmol packing.
#   Step 2: Soft potential (CG, cutoff=3.0A, A=100000) to further relax
#           atoms within a larger radius.
#   Step 3: Soft potential (CG, cutoff=6.0A, A=100000) to push apart atoms
#           at moderate distances before real LJ potential.
#
# Note: After soft potential minimization, the equilibration stage uses
# real LJ potential with gradual cutoff increase and NVE/limit to safely
# relax the remaining overlaps.

# =============================================================================
# Step 1: Soft potential with very small cutoff (1.5A)
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions (needed for bond/angle force computation)
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Use lj/cut first to match the pair_coeff format in system.in.settings
# (pair_coeff has 2 params: epsilon,sigma; soft style expects 1 param: A)
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data

# Include force field parameters (bond_coeff, angle_coeff)
include         system.in.settings

# Switch to soft potential with very small cutoff (1.5A)
# A=100000: strong repulsive force to push overlapping atoms apart
pair_style      soft 1.5
pair_coeff      * * 100000.0

# Neighbor list settings for small cutoff
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# CG minimization
min_style       cg
minimize        0.0001 0.0001 500 500

# Write step 1 result
write_data      minimized_s1.data nocoeff

# =============================================================================
# Step 2: Soft potential with medium cutoff (3.0A)
# =============================================================================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

read_data       minimized_s1.data
include         system.in.settings

# Soft potential with cutoff=3.0A, A=100000
pair_style      soft 3.0
pair_coeff      * * 100000.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press vol

min_style       cg
minimize        0.0001 0.0001 500 500

# Write step 2 result (used as input for equilibration)
write_data      minimized_s2.data nocoeff

# =============================================================================
# Step 3: Soft potential with large cutoff (6.0A) - optional final relaxation
# =============================================================================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

read_data       minimized_s2.data
include         system.in.settings

# Soft potential with cutoff=6.0A, A=100000
pair_style      soft 6.0
pair_coeff      * * 100000.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press vol

min_style       cg
minimize        0.0001 0.0001 500 500

# Write final minimized configuration
write_data      minimized.data nocoeff