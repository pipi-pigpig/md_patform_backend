# =============================================================================
# LAMMPS Minimization Input Script (Two-Step Strategy)
# Generated by Jinja2 template engine
# Generation time: 2026-06-28T14:50:05.476958700
# Job ID: 930002
# =============================================================================
#
# Two-step minimization strategy:
#   Step 1: Soft potential (FIRE algorithm) to resolve atom overlaps from
#           dense Packmol packing. Uses small cutoff (2.0 A) and small
#           neighbor skin (0.1 A) to keep neighbor list manageable.
#   Step 2: Real force field (CG algorithm) on the relaxed structure.
#           Uses lj/cut/coul/cut with reduced cutoff to avoid performance
#           issues with large neighbor lists.
#
# This approach avoids the "infinite energy" problem where overlapping
# atoms from Packmol cause LJ potential divergence.

# =============================================================================
# Step 1: Soft potential to resolve atom overlaps
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions (needed for bond/angle force computation)
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Temporarily use lj/cut to match the pair_coeff format in system.in.settings
# (pair_coeff has 2 params: epsilon,sigma; soft style expects 1 param: A)
# After including settings, we switch to soft potential and override pair_coeff
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data

# Include force field parameters (pair_coeff, bond_coeff, angle_coeff)
# pair_coeff is read under lj/cut style (2-param format) to avoid errors
include         system.in.settings

# Switch to soft potential with small cutoff to keep neighbor list small
# cutoff=2.0: limits neighbors to atoms within ~2 A, drastically reducing
#             neighbor count (from ~73M to ~4M for 12K atom system)
# Override all pair_coeff with soft potential (1 param: prefactor A=100.0)
pair_style      soft 2.0
pair_coeff      * * 100.0

# Small neighbor skin to further reduce neighbor list
neighbor        0.1 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# FIRE minimization: faster than CG for systems with large initial forces
min_style       fire
minimize        0.0001 10.0 500 500

# Write soft-minimized structure (nocoeff: skip pair coefficients to avoid
# style mismatch when reading back with real force field)
write_data      minimized_soft.data nocoeff

# =============================================================================
# Step 2: Real force field minimization
# =============================================================================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Real force field with reduced cutoff
# cutoff defaults to 8.0 but can be overridden via template context
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read the soft-minimized structure
read_data       minimized_soft.data

# Include force field parameters (pair_coeff, bond_coeff, angle_coeff)
include         system.in.settings

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 5 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# Conjugate gradient minimization on the relaxed structure
min_style       cg
minimize        0.0001 10.0 500 500

# Output final minimized configuration (nocoeff for consistency)
write_data      minimized.data nocoeff