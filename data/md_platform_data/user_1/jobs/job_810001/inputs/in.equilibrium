# =============================================================================
# LAMMPS Equilibrium Input Script (NVT + NPT)
# Generated by Jinja2 template engine
# Generation time: 2026-06-28T10:00:12.447843
# Job ID: 810001
# =============================================================================

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles (using cutoff Coulomb to handle non-neutral system charge)
# Note: The current force field assigns non-zero net charge to DMC molecules,
# making the system non-neutral. PPPM (kspace_style) requires charge neutrality,
# so we use lj/cut/coul/cut with no kspace instead of lj/cut/coul/long + pppm.
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
pair_style      lj/cut/coul/cut 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read minimized configuration
read_data       minimized.data

# Force field parameters (PPPM auto-selects grid size)
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Velocity initialization
velocity        all create 353.0 47893 dist gaussian

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol density

# Trajectory output (dump_freq from template context)
dump            1 all custom 50 dump.equilibrium.lammpstrj id mol type x y z vx vy vz

# NVT equilibration stage
timestep        1.0
fix             1 all nvt temp 353.0 353.0 100.0
run             500
unfix           1

# NPT equilibration stage
fix             2 all npt temp 353.0 353.0 100.0 iso 1.0 1.0 1000.0
run             500
unfix           2

# Output equilibrated configuration
write_data      equilibrated.data