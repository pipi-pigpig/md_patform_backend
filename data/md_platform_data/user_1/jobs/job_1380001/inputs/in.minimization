# =============================================================================
# LAMMPS Minimization Input Script (Single-Step Soft Potential Strategy)
# Generated by Jinja2 template engine
# Generation time: 2026-07-10T21:29:09.574263100
# Job ID: 1380001
# =============================================================================
#
# Single-step soft potential minimization strategy:
#   Use soft potential with small cutoff (2.5A) and A=1000 to resolve
#   inter-molecular overlaps without disturbing properly packed atoms.
#
# CRITICAL FIX (v5):
#   v4 used multi-cutoff strategy (2.5 -> 4.0 -> 6.0) which DESTROYED the
#   structure. The soft potential with larger cutoffs (4.0, 6.0) pushed
#   apart atoms at legitimate distances (2.5-6.0A), causing the molecular
#   structure to collapse. Testing showed:
#     - After step 1 (rc=2.5): min distance 1.07A, 0 pairs < 1.0A (PERFECT)
#     - After step 2 (rc=4.0): min distance 0.00A, 891 pairs < 1.0A (DESTROYED)
#     - After step 3 (rc=6.0): min distance 0.00A, 3937 pairs < 1.0A (WORSE)
#   v5 uses ONLY a single step with rc=2.5, which resolves all close contacts
#   without disturbing the properly packed structure.
#
# Why small cutoff (2.5A) works:
#   - Packmol initial structure typically has only a few close contacts
#     (min distance ~0.67A, 4 pairs < 1.0A)
#   - Soft potential with rc=2.5A only acts on pairs < 2.5A
#   - Special_bonds lj 0 0 0.5 protects bonded pairs (1-2, 1-3)
#   - A=1000 gives max force 800 at r=0, strong enough to push apart overlaps
#     but only within the small cutoff range
#
# Bond force constants for reference:
#   C-C (sp3): k=268, C=C: k=414, C=O: k=570, C-H: k=340, C-O: k=320
#   Angle force constants: k=50-80
#   With A=1000, rc=2.5: max soft force = 2*1000/2.5 = 800
#   This is stronger than angle forces (50-80) and comparable to bond forces
#   (268-570), but only acts on non-bonded pairs within 2.5A.

# =============================================================================
# Single Step: Soft potential with small cutoff (2.5A) - resolve all overlaps
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions (needed for bond/angle force computation)
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Use lj/cut first to match the pair_coeff format in system.in.settings
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data

# Include force field parameters (bond_coeff, angle_coeff)
include         system.in.settings

# Switch to soft potential with small cutoff (2.5A)
# A=1000: strong repulsive force (max 2*A/rc = 800 at r=0)
# Only acts on pairs < 2.5A, preserving properly packed structure
pair_style      soft 2.5
pair_coeff      * * 1000.0

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# SD minimization (Steepest Descent - robust for high-energy starts)
min_style       sd
minimize        1e-06 0.0001 5000 5000

# Write final minimized configuration
write_data      minimized.data nocoeff
