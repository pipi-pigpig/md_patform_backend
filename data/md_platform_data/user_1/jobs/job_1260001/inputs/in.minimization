# =============================================================================
# LAMMPS Minimization Input Script (Strong Soft Potential Strategy)
# Generated by Jinja2 template engine
# Generation time: 2026-06-29T21:36:38.357715200
# Job ID: 1260001
# =============================================================================
#
# Three-step soft potential minimization strategy:
#   Step 1: Soft potential (A=1000, cutoff=2.5A) to resolve the worst
#           inter-molecular overlaps.
#   Step 2: Soft potential (A=1000, cutoff=4.0A) to further relax
#           moderate-distance contacts.
#   Step 3: Soft potential (A=1000, cutoff=6.0A) to push apart all atoms
#           within LJ interaction range.
#
# CRITICAL FIX (v4):
#   v3 used A=100 (max force 67) which was too weak. Bonded forces (bonds,
#   angles) pushed atoms into each other, and the soft potential could not
#   prevent it. Result: 137 pairs < 0.5A after minimization, causing LJ
#   energy explosion (3.93e156) when switching to real LJ.
#   v2 used A=10000 (max force 8000) which was too strong, destroying bonds
#   (stretched to 12A, compressed to 0.003A).
#   v4 uses A=1000 (max force 800 at cutoff=2.5, 500 at cutoff=4.0, 333 at
#   cutoff=6.0). This is comparable to bond forces (k=268-570) and much
#   stronger than angle forces (k=50-80), allowing effective separation of
#   overlaps without destroying molecular structure.
#
# Bond force constants for reference:
#   C-C (sp3): k=268, C=C: k=414, C=O: k=570, C-H: k=340, C-O: k=320
#   Angle force constants: k=50-80
#   With A=1000:
#     cutoff=2.5: max soft force = 2*1000/2.5 = 800
#     cutoff=4.0: max soft force = 2*1000/4.0 = 500
#     cutoff=6.0: max soft force = 2*1000/6.0 = 333
#   The soft force is stronger than angle forces (50-80) at all cutoffs,
#   ensuring atoms are pushed apart. At cutoff=6.0, the soft force (333)
#   is comparable to bond forces (268-570), providing enough repulsion to
#   keep non-bonded atoms apart while not destroying bonds.

# =============================================================================
# Step 1: Soft potential with small cutoff (2.5A) - resolve worst overlaps
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions (needed for bond/angle force computation)
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Use lj/cut first to match the pair_coeff format in system.in.settings
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data

# Include force field parameters (bond_coeff, angle_coeff)
include         system.in.settings

# Switch to soft potential with small cutoff (2.5A)
# A=1000: strong repulsive force (max 2*A/rc = 800 at r=0)
# This is stronger than angle forces (50-80) and comparable to bond forces (268-570)
pair_style      soft 2.5
pair_coeff      * * 1000.0

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# SD minimization (Steepest Descent - robust for high-energy starts)
min_style       sd
minimize        1e-06 0.0001 5000 5000

# Write step 1 result
write_data      minimized_s1.data nocoeff

# =============================================================================
# Step 2: Soft potential with medium cutoff (4.0A) - relax moderate contacts
# =============================================================================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

read_data       minimized_s1.data
include         system.in.settings

# Soft potential with cutoff=4.0A, A=1000
# Max force at r=0: 2*1000/4.0 = 500
pair_style      soft 4.0
pair_coeff      * * 1000.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press vol

min_style       sd
minimize        1e-06 0.0001 5000 5000

# Write step 2 result
write_data      minimized_s2.data nocoeff

# =============================================================================
# Step 3: Soft potential with large cutoff (6.0A) - final relaxation
# This ensures ALL atoms within LJ interaction range are pushed to safe
# distances (>= ~2.5A). The LJ transition is handled in the equilibrium
# phase using NVE/limit, which is more robust than direct CG minimization.
# =============================================================================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

read_data       minimized_s2.data
include         system.in.settings

# Soft potential with cutoff=6.0A, A=1000
# Max force at r=0: 2*1000/6.0 = 333
# This ensures all non-bonded pairs within LJ range are separated
pair_style      soft 6.0
pair_coeff      * * 1000.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          100
thermo_style    custom step temp pe ke etotal press vol

min_style       sd
minimize        1e-06 0.0001 5000 5000

# Write final minimized configuration
write_data      minimized.data nocoeff
