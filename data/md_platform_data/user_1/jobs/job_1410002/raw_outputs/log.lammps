# Neighbor list settings (delay 5 to reduce overhead)
neighbor        2.0 bin
neigh_modify    every 1 delay 5 check yes

# Thermodynamic output
thermo          1000

thermo_style    custom step temp pe ke etotal press vol density


# Output thermodynamic data to thermo.out file (for post-processing analysis)
# Format: step temp pe ke etotal press vol density
variable        s_out equal step
variable        t_out equal temp
variable        pe_out equal pe
variable        ke_out equal ke
variable        et_out equal etotal
variable        pr_out equal press
variable        v_out equal vol
variable        d_out equal density
fix             thermo_out all print 1000 "${s_out} ${t_out} ${pe_out} ${ke_out} ${et_out} ${pr_out} ${v_out} ${d_out}" file thermo.out screen no

# Trajectory output (production)
dump            1 all custom 500 dump.trajectory.lammpstrj id mol type x y z vx vy vz


# Conductivity/Dielectric: output trajectory with charges AND velocities
# Green-Kubo电导率计算需要同时包含电荷(q)和速度(vx,vy,vz)
# 因为 J = Σ(qi*vi)，缺少速度会导致电流密度为0
compute         charge all property/atom q
dump            2 all custom 500 dump.charge.lammpstrj id type x y z vx vy vz c_charge








# NPT production simulation
timestep        1.0
fix             1 all npt temp 353.0 353.0 100.0 iso 1.0 1.0 1000.0
run             100000
