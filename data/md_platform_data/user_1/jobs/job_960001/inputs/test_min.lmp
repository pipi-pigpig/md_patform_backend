units           real
atom_style      full
dimension       3
boundary        p p p
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none
read_data       system.data
include         system.in.settings
thermo          1
thermo_style    custom step temp pe ke etotal
run             0
