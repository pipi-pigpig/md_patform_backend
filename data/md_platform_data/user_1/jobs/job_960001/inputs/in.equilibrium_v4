# Equilibrium with gradual relaxation
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Use small cutoff initially to avoid energy explosion
pair_style      lj/cut/coul/cut 4.0 4.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

read_data       minimized_s2.data
include         system.in.settings

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Phase 1: NVE with very small displacement limit
timestep        0.1
fix             nve_limit all nve/limit 0.05
thermo          10
thermo_style    custom step temp pe ke etotal press vol density
run             500
unfix           nve_limit

# Phase 2: Increase cutoff and continue NVE
pair_style      lj/cut/coul/cut 6.0 6.0
include         system.in.settings
fix             nve_limit all nve/limit 0.1
run             500
unfix           nve_limit

# Phase 3: Full cutoff, NVE
pair_style      lj/cut/coul/cut 8.0 8.0
include         system.in.settings
fix             nve_limit all nve/limit 0.2
run             500
unfix           nve_limit

# Phase 4: NVT equilibration
velocity        all create 353.0 75294 dist gaussian
fix             nvt all nvt temp 353.0 353.0 100.0
timestep        0.5
dump            1 all custom 50 dump.equilibrium.lammpstrj id mol type x y z vx vy vz
run             500
unfix           nvt

write_data      equilibrated.data
