units           real
atom_style      full
dimension       3
boundary        p p p
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
pair_style      lj/cut/coul/cut 2.0 2.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none
read_data       minimized.data
include         system.in.settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
thermo          1
thermo_style    custom step temp pe ke etotal press vol
run             0
