# =============================================================================
# LAMMPS Minimization Input Script (Two-Step Strategy)
# Generated by Jinja2 template engine
# Generation time: 2026-06-28T20:00:00
# Job ID: 960001
# =============================================================================
#
# Two-step minimization strategy:
#   Step 1: Soft potential (CG algorithm) with small cutoff (2.0 A) to
#           resolve the worst atom overlaps from Packmol packing.
#   Step 2: Soft potential (CG algorithm) with larger cutoff (4.0 A) to
#           further relax the structure for real force field.
#
# Note: Real force field minimization is skipped because soft potential
# cannot fully resolve all LJ overlaps. The equilibration stage (NVT+NPT)
# will handle the remaining relaxation with the real force field.

# =============================================================================
# Step 1: Soft potential to resolve atom overlaps
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions (needed for bond/angle force computation)
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Temporarily use lj/cut to match the pair_coeff format in system.in.settings
# (pair_coeff has 2 params: epsilon,sigma; soft style expects 1 param: A)
# After including settings, we switch to soft potential and override pair_coeff
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data

# Include force field parameters (pair_coeff, bond_coeff, angle_coeff)
# pair_coeff is read under lj/cut style (2-param format) to avoid errors
include         system.in.settings

# Switch to soft potential with small cutoff to keep neighbor list small
# cutoff=2.0: limits neighbors to atoms within ~2 A, drastically reducing
#             neighbor count (from ~73M to ~4M for 12K atom system)
# Override all pair_coeff with soft potential (1 param: prefactor A=1000.0)
# Higher A value creates stronger repulsive force to push overlapping atoms apart
pair_style      soft 2.0
pair_coeff      * * 1000.0

# Neighbor list settings for soft potential
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# CG minimization: more stable than FIRE for soft potential
min_style       cg
minimize        0.0001 0.0001 500 500

# Write soft-minimized structure (nocoeff: skip pair coefficients to avoid
# style mismatch when reading back with real force field)
write_data      minimized_soft.data nocoeff

# =============================================================================
# Step 2: Soft potential with larger cutoff for further relaxation
# =============================================================================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Use soft potential with larger cutoff (4.0 A) to resolve more overlaps
# before handing off to real force field in equilibration
# Strategy: first use lj/cut to match system.in.settings pair_coeff format,
# then switch to soft potential and override pair_coeff
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read the soft-minimized structure from Step 1
read_data       minimized_soft.data

# Include force field parameters (bond_coeff, angle_coeff from system.in.settings)
include         system.in.settings

# Switch to soft potential with larger cutoff and override pair_coeff
# A=10000.0 with cutoff 6.0A: stronger repulsion to push atoms safely apart
# before handing off to real LJ potential in equilibration
pair_style      soft 6.0
pair_coeff      * * 10000.0

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# CG minimization on the relaxed structure with larger cutoff
min_style       cg
minimize        0.0001 0.0001 500 500

# Output final minimized configuration (nocoeff for consistency)
write_data      minimized.data nocoeff