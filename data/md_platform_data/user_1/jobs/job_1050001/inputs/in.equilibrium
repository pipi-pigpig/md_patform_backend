# =============================================================================
# LAMMPS Equilibrium Input Script (Gradual Relaxation + NVT + NPT)
# Generated by Jinja2 template engine
# Generation time: 2026-06-29T15:20:18.066395400
# Job ID: 1050001
# =============================================================================
#
# Gradual relaxation strategy:
#   Phase 1: NVE/limit with small cutoff (4.0A) to safely relax atoms
#            without energy explosion from real LJ potential.
#   Phase 2: NVE/limit with medium cutoff (6.0A) to include more neighbors.
#   Phase 3: NVE/limit with full cutoff (8.0A) to reach full interaction range.
#   Phase 4: NVT thermostat at target temperature.
#   Phase 5: NPT barostat at target pressure.
#
# The key insight: soft potential minimization cannot fully resolve LJ overlaps
# because the soft potential A*(1-r/rc)^2 is much weaker than LJ 1/r^12 at
# short distances. Gradual cutoff increase with NVE/limit allows atoms to
# slowly adjust under real forces without catastrophic energy spikes.

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles (using cutoff Coulomb to handle non-neutral system charge)
# Note: PPPM requires charge neutrality. The current OPLS-AA force field
# may give molecules non-zero net charge, making the system non-neutral.
# Using lj/cut/coul/cut with no kspace as a workaround.
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read minimized configuration (from minimization step 2: minimized_s2.data)
read_data       minimized_s2.data

# Force field parameters
include         system.in.settings

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# =============================================================================
# Phase 1: NVE with small cutoff (4.0A) and strict displacement limit
# =============================================================================
timestep        0.1
fix             nve_limit all nve/limit 0.05
thermo          10
thermo_style    custom step temp pe ke etotal press vol density
run             500
unfix           nve_limit

# =============================================================================
# Phase 2: NVE with medium cutoff (6.0A)
# =============================================================================
pair_style      lj/cut/coul/cut 6.0 6.0
include         system.in.settings
fix             nve_limit all nve/limit 0.1
run             500
unfix           nve_limit

# =============================================================================
# Phase 3: NVE with full cutoff (8.0A)
# =============================================================================
pair_style      lj/cut/coul/cut 8.0 8.0
include         system.in.settings
fix             nve_limit all nve/limit 0.2
run             500
unfix           nve_limit

# =============================================================================
# Phase 4: NVT equilibration
# =============================================================================
velocity        all create 353.0 63103 dist gaussian
fix             nvt all nvt temp 353.0 353.0 100.0
timestep        1.0

# Trajectory output
dump            1 all custom 50 dump.equilibrium.lammpstrj id mol type x y z vx vy vz

run             500
unfix           nvt

# =============================================================================
# Phase 5: NPT equilibration
# =============================================================================
fix             npt all npt temp 353.0 353.0 100.0 iso 1.0 1.0 1000.0
timestep        1.0
run             500
unfix           npt

# Output equilibrated configuration
write_data      equilibrated.data