# =============================================================================
# LAMMPS Minimization Input Script
# Generated by Jinja2 template engine
# Generation time: 2026-06-26T01:19:28.511763800
# Job ID: 600001
# =============================================================================
#
# Four-step minimization strategy for systems with severe atom overlaps:
#   Step 1: Soft sphere repulsion (handles r->0 overlaps safely)
#   Step 2: LJ-only pre-minimization (removes residual bad contacts)
#   Step 3: Full force field FIRE minimization
#   Step 4: Conjugate gradient fine convergence
#

# ============================
# Step 1: Soft sphere pre-minimization
# ============================
# Purpose: Push apart atoms that are at zero or near-zero separation.
# The soft pair style uses a cosine-squared potential that is always finite,
# unlike LJ which goes to infinity at r=0.
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Minimal force field settings (only bonds/angles needed for topology)
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic

# Soft sphere - gentle repulsion for all atom pairs
pair_style      soft 12.0
pair_coeff      * * 50.0
kspace_style    none

# Read structure file
read_data       system.data

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# Use very small timestep safe for severely overlapping atoms
timestep        0.1

# FIRE algorithm for rapid bad contact removal
min_style       fire
minimize        1.0e-4 1.0e-6 50000 10000

# Save intermediate structure
write_data      /tmp/minimization_step1.data

# ============================
# Step 2: LJ-only pre-minimization
# ============================
# Purpose: Continue removing overlaps using realistic LJ repulsion.
# Now that atoms are no longer at r=0, the LJ potential is well-behaved.
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles (LJ-only, no Coulomb)
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut 12.0
kspace_style    none

# Read step 1 minimized structure
read_data       /tmp/minimization_step1.data

# Force field parameters (LJ coefficients)
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# Restore normal timestep (soft step already resolved extreme overlaps)
timestep        0.5

# FIRE continuation
min_style       fire
minimize        1.0e-4 1.0e-6 100000 20000

# Save intermediate structure
write_data      /tmp/minimization_step2.data

# ============================
# Step 3: Full force field FIRE
# ============================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Full force field with Coulomb and PPPM
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut/coul/long 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    pppm 1.0e-4

# Read step 2 minimized structure
read_data       /tmp/minimization_step2.data

# Force field parameters
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# Normal timestep for full force field
timestep        1.0

# FIRE minimization with full force field
min_style       fire
minimize        1.0e-4 1.0e-6 50000 10000

# Save intermediate structure
write_data      /tmp/minimization_step3.data

# ============================
# Step 4: CG fine convergence
# ============================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Full force field with Coulomb and PPPM
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut/coul/long 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    pppm 1.0e-4

# Read step 3 minimized structure
read_data       /tmp/minimization_step3.data

# Force field parameters
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

timestep        1.0

# Conjugate gradient for precise convergence
min_style       cg
minimize        1.0e-4 10.0 20000 10000

# Output final minimized configuration
write_data      minimized.data

# Clean up temporary files
shell           rm -f /tmp/minimization_step1.data /tmp/minimization_step2.data /tmp/minimization_step3.data