#
# Five-phase gradual relaxation strategy:
#   Phase 0: CG minimization with real LJ (cutoff=4.0A) to resolve remaining
#            atom overlaps that soft potential minimization could not handle.
#            The CG minimizer safely pushes apart overlapping atoms by
#            backtracking, unlike NVE/limit which diverges with inf energy.
#   Phase 1: NVE/limit with small cutoff (4.0A) to dynamically relax atoms
#            without energy explosion from real LJ potential.
#   Phase 2: NVE/limit with medium cutoff (6.0A) to include more neighbors.
#   Phase 3: NVE/limit with full cutoff (8.0A) to reach full interaction range.
#   Phase 4: NVT thermostat at target temperature.
#   Phase 5: NPT barostat at target pressure.
#
# Key insight: soft potential A*(1-r/rc)^2 is finite at r=0, but LJ 1/r^12
# diverges. After soft potential minimization, some atom pairs may still be
# too close for LJ dynamics. CG minimization with real LJ resolves this by
# directly moving atoms to reduce energy, without velocity-induced instability.

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles (using cutoff Coulomb to handle non-neutral system charge)
# Note: PPPM requires charge neutrality. The current OPLS-AA force field
# may give molecules non-zero net charge, making the system non-neutral.
# Using lj/cut/coul/cut with no kspace as a workaround.
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Phase 0 uses small cutoff (4.0A) for CG minimization
# Note: NOT using 8.0 here because Java passes 8.0 which is too large
# for the initial real LJ interaction after soft potential minimization.
pair_style      lj/cut/coul/cut 4.0 4.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read the FINAL minimized configuration (from minimization step 3: minimized.data)
# NOT minimized_s2.data which is the intermediate result from step 2
read_data       minimized.data
