# =============================================================================
# LAMMPS Production Simulation Input Script
# Generated by Jinja2 template engine
# Generation time: 2026-06-26T00:18:11.141782700
# Job ID: 510003
# Target properties: density, conductivity
# =============================================================================

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut/coul/long 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    pppm 1.0e-4

# Read equilibrated configuration
read_data       equilibrated.data

# Force field parameters (PPPM auto-selects grid size)
include         system.in.settings

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          1000

thermo_style    custom step temp pe ke etotal press vol density


# Trajectory output (production)
dump            1 all custom 10000 dump.trajectory.lammpstrj id mol type x y z vx vy vz


# Conductivity/Dielectric: output trajectory with charges
compute         charge all property/atom q
dump            2 all custom 10000 dump.charge.lammpstrj id type x y z c_charge








# NPT production simulation
timestep        1.0
fix             1 all npt temp 353.0 353.0 100.0 iso 1.0 1.0 1000.0
run             1000
unfix           1

# Output final configuration
write_data      final.data