# =============================================================================
# LAMMPS Minimization Input Script
# Generated by Jinja2 template engine
# Generation time: 2026-06-28T10:26:01.552630900
# Job ID: 810004
# =============================================================================
#
# Single-step CG minimization strategy:
#   - Reads the Moltemplate-generated structure (system.data) directly
#   - Includes the full force field (system.in.settings)
#   - Runs conjugate gradient minimization to convergence
#   - Uses cutoff Coulomb (no kspace) to handle non-neutral systems
#
# This single-step approach avoids clear/restart issues that can occur
# with two-step (soft sphere then full force field) strategies.

# Initialization
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Non-bonded interactions (cutoff Coulomb, no kspace for non-neutral systems)
# Reduced cutoff (8.0) to avoid neighbor list overflow in dense Packmol-packed systems
pair_style      lj/cut/coul/cut 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data

# Force field parameters
include         system.in.settings

# Neighbor list settings
# delay 5: delay neighbor list updates for 5 steps to reduce overhead during minimization
neighbor        2.0 bin
neigh_modify    every 1 delay 5 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

timestep        1.0

# Conjugate gradient minimization
min_style       cg
minimize        0.0001 10.0 500 500

# Output final minimized configuration
write_data      minimized.data