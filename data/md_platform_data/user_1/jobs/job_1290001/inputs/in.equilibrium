# =============================================================================
# LAMMPS Equilibrium Input Script (Gradual LJ Transition via NVE/limit)
# Generated by Jinja2 template engine
# Generation time: 2026-06-29T22:38:42.869989800
# Job ID: 1290001
# =============================================================================
#
# Six-phase gradual relaxation strategy:
#   Phase 0: NVE/limit with real LJ (cutoff=4.0A) and tiny timestep.
#            After soft potential minimization, atoms are at safe distances
#            (>= ~2.5A). NVE/limit with small displacement limit (0.02A)
#            safely transitions to real LJ dynamics without energy explosions.
#   Phase 1: NVE/limit with cutoff=5.0A.
#   Phase 2: NVE/limit with cutoff=6.0A.
#   Phase 3: NVE/limit with full cutoff=8.0A.
#   Phase 4: NVT thermostat at target temperature.
#   Phase 5: NPT barostat at target pressure.
#
# CRITICAL FIX (v4):
#   v3 used CG minimization for the LJ transition (Phase 0), which failed
#   because CG can make large steps that cause atoms to overlap.
#   v4 uses NVE/limit which limits displacement per step, preventing
#   energy explosions even if some close contacts remain.
#
# Why NVE/limit instead of CG minimization:
#   - CG minimization uses line search, which can fail (alpha=0) when forces
#     are extreme, leaving the structure unrelaxed.
#   - NVE/limit simply limits displacement per step, always making progress.
#   - NVE/limit is faster (no line search) and more robust.

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Start with real LJ at small cutoff=4.0A for safe transition
pair_style      lj/cut/coul/cut 4.0 4.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read the FINAL minimized configuration (from minimization step 3)
read_data       minimized.data

# Include force field parameters (bond_coeff, angle_coeff, pair_coeff)
include         system.in.settings

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol density

# =============================================================================
# Phase 0: NVE/limit with real LJ (cutoff=4.0A)
# Very small timestep (0.05 fs) and strict displacement limit (0.02 A).
# This safely transitions from soft potential to real LJ dynamics.
# =============================================================================
timestep        0.05
fix             nve_limit all nve/limit 0.02
run             500
unfix           nve_limit

# =============================================================================
# Phase 1: NVE/limit with cutoff=5.0A
# =============================================================================
pair_style      lj/cut/coul/cut 5.0 5.0
include         system.in.settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.1
fix             nve_limit all nve/limit 0.05
run             500
unfix           nve_limit

# =============================================================================
# Phase 2: NVE/limit with cutoff=6.0A
# =============================================================================
pair_style      lj/cut/coul/cut 6.0 6.0
include         system.in.settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
fix             nve_limit all nve/limit 0.1
run             500
unfix           nve_limit

# =============================================================================
# Phase 3: NVE/limit with full cutoff=8.0A
# =============================================================================
pair_style      lj/cut/coul/cut 8.0 8.0
include         system.in.settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.25
fix             nve_limit all nve/limit 0.2
run             500
unfix           nve_limit

# =============================================================================
# Phase 4: NVT equilibration
# =============================================================================
velocity        all create 353.0 52686 dist gaussian
fix             nvt all nvt temp 353.0 353.0 100.0
timestep        1.0

# Trajectory output
dump            1 all custom 50 dump.equilibrium.lammpstrj id mol type x y z vx vy vz

run             500
unfix           nvt

# =============================================================================
# Phase 5: NPT equilibration
# =============================================================================
fix             npt all npt temp 353.0 353.0 100.0 iso 1.0 1.0 1000.0
timestep        1.0
run             500
unfix           npt

# Output equilibrated configuration
write_data      equilibrated.data
