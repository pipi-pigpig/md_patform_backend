dihedral_coeff 1  0.0  0.0  0.278  0.0   # C-C-C-C (烷烃)
dihedral_coeff 2  0.0  0.0  0.0    0.0   # C-C-C-C (烯烃)

# 碳-碳-碳-氢二面角
dihedral_coeff 3  0.0  0.0  0.278  0.0   # C-C-C-H

# 氢-碳-碳-氢二面角
dihedral_coeff 4 0.0  0.0  0.278  0.0   # H-C-C-H

# 碳-氧-碳-碳二面角
dihedral_coeff 5  0.5 -0.5  0.5   0.0   # C-O-C-C (醚)
dihedral_coeff 6 0.0  0.0  0.0   0.0   # C-O-C-C (酯)

# 碳-碳-氧-碳二面角
dihedral_coeff 7  0.0  0.0  0.0   0.0   # C-C-O-C

# 氧-碳-氧-碳二面角
dihedral_coeff 8  0.0  0.0  0.0   0.0   # O-C-O-C (碳酸酯)

# 碳-碳-氧=碳二面角
dihedral_coeff 9 0.0  0.0  0.0  0.0   # C-C-O=C (羰基)
# 羰基平面构型
improper_coeff 1  10.0  0.0   # C=O平面

# 芳香平面构型
improper_coeff 2  10.0  0.0   # 芳香平面
pair_coeff 31 31 0.00034 2.126

# 邻居列表设置
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# 热力学输出
thermo          100

thermo_style    custom step temp pe ke etotal press vol density


# 轨迹输出
dump            1 all custom 1000 dump.trajectory.lammpstrj id mol type x y z vx vy vz


# 电导率/介电常数计算：输出带电荷的轨迹
compute         charge all property/atom q
dump            2 all custom 1000 dump.charge.lammpstrj id type x y z c_charge








# NPT生产模拟
timestep        1.0
fix             1 all npt temp 300.0 300.0 100.0 iso 1.0 1.0 1000.0
run             100000

