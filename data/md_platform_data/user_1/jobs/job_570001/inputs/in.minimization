# =============================================================================
# LAMMPS Minimization Input Script
# Generated by Jinja2 template engine
# Generation time: 2026-06-26T01:07:38.921530
# Job ID: 570001
# =============================================================================
#
# Three-step minimization strategy:
#   Step 1: LJ-only pre-minimization (remove severe atom overlaps, no Coulomb)
#   Step 2: Full force field FIRE minimization (Coulomb + LJ)
#   Step 3: CG fine convergence for high-precision final structure
#

# ============================
# Step 1: LJ-only pre-minimization
# ============================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles (LJ-only, no Coulomb)
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut 12.0
kspace_style    none

# Read structure file
read_data       system.data

# Force field parameters
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# Use small timestep for severely overlapping atoms
timestep        0.1

# FIRE algorithm for rapid bad contact removal
min_style       fire
minimize        1.0e-4 1.0e-6 300000 20000

# Save intermediate structure
write_data      /tmp/minimization_step1.data

# ============================
# Step 2: Full force field FIRE
# ============================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Full force field with Coulomb and PPPM
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut/coul/long 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    pppm 1.0e-4

# Read step 1 minimized structure
read_data       /tmp/minimization_step1.data

# Force field parameters
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# Restore normal timestep
timestep        1.0

# FIRE continuation
min_style       fire
minimize        1.0e-4 1.0e-6 100000 10000

# Save intermediate structure
write_data      /tmp/minimization_step2.data

# ============================
# Step 3: CG fine convergence
# ============================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Full force field with Coulomb and PPPM
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut/coul/long 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    pppm 1.0e-4

# Read step 2 minimized structure
read_data       /tmp/minimization_step2.data

# Force field parameters
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

timestep        1.0

# Conjugate gradient for precise convergence
min_style       cg
minimize        1.0e-4 10.0 20000 10000

# Output final minimized configuration
write_data      minimized.data

# Clean up temporary files
shell           rm -f /tmp/minimization_step1.data /tmp/minimization_step2.data