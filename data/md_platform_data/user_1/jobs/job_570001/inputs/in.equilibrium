# =============================================================================
# LAMMPS Equilibrium Input Script (NVT + NPT)
# Generated by Jinja2 template engine
# Generation time: 2026-06-26T01:07:38.921530
# Job ID: 570001
# =============================================================================

# Initialization settings
units           real
atom_style      full
dimension       3
boundary        p p p

# Force field styles
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut/coul/long 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    pppm 1.0e-4

# Read minimized configuration
read_data       minimized.data

# Force field parameters (PPPM auto-selects grid size)
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Velocity initialization
velocity        all create 353.0 46978 dist gaussian

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol density

# Trajectory output
dump            1 all custom 1000 dump.equilibrium.lammpstrj id mol type x y z vx vy vz

# NVT equilibration stage
timestep        1.0
fix             1 all nvt temp 353.0 353.0 100.0
run             500
unfix           1

# NPT equilibration stage
fix             2 all npt temp 353.0 353.0 100.0 iso 1.0 1.0 1000.0
run             500
unfix           2

# Output equilibrated configuration
write_data      equilibrated.data