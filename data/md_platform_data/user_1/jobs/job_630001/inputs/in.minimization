# =============================================================================
# LAMMPS Minimization Input Script
# Generated by Jinja2 template engine
# Generation time: 2026-06-26T12:00:00
# Job ID: 630001
# =============================================================================
#
# Three-step minimization strategy:
#   Step 1: Soft sphere (removes atom overlaps)
#   Step 2: Full bond/LJ with cutoff Coulomb (no kspace, handles non-neutral)
#   Step 3: Full force field with PPPM (requires charge neutrality)

# ============================
# Step 1: Soft sphere pre-minimization
# ============================
clear
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      none
angle_style     none
dihedral_style  none
improper_style  none

pair_style      soft 12.0
kspace_style    none

read_data       system.data

pair_coeff      * * 500.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

thermo          100
thermo_style    custom step temp pe ke etotal press vol

timestep        0.05

min_style       cg
minimize        1.0e-15 1.0 100000 20000

write_data      /tmp/minimization_step1.data nocoeff

# ============================
# Step 2: Full force field CG (cutoff Coulomb, no kspace)
# ============================
# Purpose: Full force field minimization with short-range Coulomb (no kspace).
# Uses lj/cut/coul/cut instead of lj/cut/coul/long + pppm to avoid PPPM's
# requirement for charge-neutral systems. The current force field assigns
# non-zero net charge to DMC molecules (+0.12 ea), making the system
# non-neutral (total charge ~+84.84 for 707 DMC molecules).
#
# Note: Minimization converges, but Step 3 / equilibrium will also need
# to avoid PPPM due to the same charge neutrality issue.
clear
units           real
atom_style      full
dimension       3
boundary        p p p

bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut/coul/cut 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

read_data       /tmp/minimization_step1.data

include         system.in.settings

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

thermo          100
thermo_style    custom step temp pe ke etotal press vol

timestep        1.0

min_style       cg
minimize        1.0e-4 1.0e-4 20000 10000

write_data      minimized.data

shell           rm -f /tmp/minimization_step1.data