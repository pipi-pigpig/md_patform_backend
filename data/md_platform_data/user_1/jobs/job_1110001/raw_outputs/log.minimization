#
# Three-step minimization strategy:
#   Step 1: Soft potential (CG, cutoff=1.5A, A=100000) to resolve the worst
#           atom overlaps from Packmol packing.
#   Step 2: Soft potential (CG, cutoff=3.0A, A=100000) to further relax
#           atoms within a larger radius.
#   Step 3: Soft potential (CG, cutoff=6.0A, A=100000) to push apart atoms
#           at moderate distances before real LJ potential.
#
# Note: After soft potential minimization, the equilibration stage uses
# real LJ potential with gradual cutoff increase and NVE/limit to safely
# relax the remaining overlaps.

# =============================================================================
# Step 1: Soft potential with very small cutoff (1.5A)
# =============================================================================
units           real
atom_style      full
dimension       3
boundary        p p p

# Bonded interactions (needed for bond/angle force computation)
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none

# Use lj/cut first to match the pair_coeff format in system.in.settings
# (pair_coeff has 2 params: epsilon,sigma; soft style expects 1 param: A)
pair_style      lj/cut/coul/cut 8.0 8.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read structure file
read_data       system.data
