# =============================================================================
# Phase 0a: Soft potential CG minimization (cutoff=8.0A)
# Push all overlapping atoms to safe distances before real LJ.
# A=100000 provides strong repulsive force up to 8.0A cutoff.
# =============================================================================
pair_style      soft 8.0
pair_coeff      * * 100000.0
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
min_style       cg
minimize        1.0e-4 1.0e-4 500 500
