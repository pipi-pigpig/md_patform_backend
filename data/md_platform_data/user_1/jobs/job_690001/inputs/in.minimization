# =============================================================================
# LAMMPS Minimization Input Script
# Generated by Jinja2 template engine
# Generation time: 2026-06-27T13:14:03.452957800
# Job ID: 690001
# =============================================================================
#
# Two-step minimization strategy for systems with severe atom overlaps:
#   Step 1: Aggressive soft sphere (force-only convergence, no etol limit)
#           - Uses bond_style none to avoid bonded coeff requirements
#           - Negative etol disables energy tolerance check
#           - High amplitude pushes atoms far apart
#   Step 2: Full force field CG (includes Coulomb via PPPM)
#
# Note: system.in.settings is included only in Step 2 (after read_data).
#

# ============================
# Step 1: Aggressive soft sphere pre-minimization
# ============================
# Use force-only convergence (etol=-1 disables energy check, only ftol matters)
# This prevents premature convergence on energy plateau while forces are still high.
# The soft potential is always finite at r=0, unlike LJ which diverges.
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Disable bonded interactions (coefficients in system.in.settings require a
# defined simulation box via read_data, and we only include settings in Step 2)
bond_style      none
angle_style     none
dihedral_style  none
improper_style  none

# Soft sphere - repulsion for all atom pairs
pair_style      soft 12.0
kspace_style    none

# Read structure file FIRST (box must be defined before any pair_coeff)
read_data       system.data

# Then set pair coefficients (simulation box is now defined)
pair_coeff      * * 500.0

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

# Very small timestep for stability with high amplitude
timestep        0.1

# CG minimization with force-dominated convergence (very small etol ensures
# the minimizer primarily stops on force convergence or max iterations)
min_style       cg
minimize        1.0e-15 1.0 10000 5000

# Save intermediate structure without coefficients (they will be set via
# system.in.settings in Step 2 after read_data, avoiding format mismatch)
write_data      /tmp/minimization_step1.data nocoeff

# ============================
# Step 2: Full force field CG (cutoff Coulomb, no kspace)
# ============================
# Purpose: Full force field minimization with short-range Coulomb (no kspace).
# Uses lj/cut/coul/cut instead of lj/cut/coul/long + pppm to avoid PPPM's
# requirement for charge-neutral systems. The current force field assigns
# non-zero net charge to DMC molecules (+0.12 ea), making the system
# non-neutral (total charge ~+84.84 for 707 DMC molecules).
clear
units           real
atom_style      full
dimension       3
boundary        p p p

# Full force field with cutoff Coulomb (no kspace, handles non-neutral charge)
bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  harmonic
pair_style      lj/cut/coul/cut 12.0 12.0
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
kspace_style    none

# Read minimized structure (no pair coefficients in file)
read_data       /tmp/minimization_step1.data

# Force field parameters (all coefficients, after read_data = box defined)
include         system.in.settings

# Neighbor list settings (increased page/one for dense systems)
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 100000 page 1000000

# Thermodynamic output
thermo          100
thermo_style    custom step temp pe ke etotal press vol

timestep        1.0

# Conjugate gradient for precise convergence
min_style       cg
minimize        1.0e-4 10.0 3000 3000

# Output final minimized configuration
write_data      minimized.data

# Clean up temporary files
shell           rm -f /tmp/minimization_step1.data